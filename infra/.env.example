# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=assetslake
POSTGRES_USER=assetslake
POSTGRES_PASSWORD=assetslake_secret
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
POSTGRES_REPLICATION_USER=assetslake_replicator
POSTGRES_REPLICATION_PASSWORD=assetslake_replicator_secret
POSTGRES_AI_REPLICA_USER=assetslake_ai_replica
POSTGRES_AI_REPLICA_PASSWORD=assetslake_ai_replica_secret

# ─── MinIO ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_BUCKET=art-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_MIRROR_API_PORT=9010
MINIO_MIRROR_CONSOLE_PORT=9011
MINIO_AI_REPLICA_USER=assetslake_ai_replica
MINIO_AI_REPLICA_PASSWORD=assetslake_ai_replica_secret
# Public-facing MinIO endpoint is no longer used for asset download links when
# ASSET_SIGNED_URLS_ENABLED=true; assets are served through backend signed URLs.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ─── Backend ──────────────────────────────────────────────────
BACKEND_PORT=8080
ASSETSLAKE_SERVICE=gateway
RUST_LOG=info
MAX_UPLOAD_SIZE_MB=500
ASSET_SIGNED_URLS_ENABLED=true
ASSET_SIGNED_URL_TTL_SECONDS=300
ASSET_READ_AUTH_REQUIRED=true
ASSET_ACCESS_AUDIT_ENABLED=true
ASSET_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
MAX_ASSET_FILENAME_BYTES=180
ASSET_BLOCKED_EXTENSIONS=exe,dll,com,scr,msi,dmg,app,deb,rpm,apk,ipa,jar,war,ear,svg
ASSET_BLOCKED_MIME_TYPES=application/x-msdownload,application/x-dosexec,application/x-msi,image/svg+xml,text/html,application/xhtml+xml
SERVER_WORKERS=0
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_ACQUIRE_TIMEOUT_SECONDS=3
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_VERIFICATION_MAX=10
RATE_LIMIT_VERIFICATION_WINDOW_SECONDS=300
BACKEND_MAINTENANCE_ENABLED=true
BACKEND_MAINTENANCE_INTERVAL_SECONDS=300
SESSION_RETENTION_HOURS=168
RELEASED_LOCK_RETENTION_HOURS=24
VERIFICATION_OUTBOX_RETENTION_HOURS=72

# ─── Qdrant / RAG Memory ──────────────────────────────────────
QDRANT_PORT=6333
QDRANT_REPLICA_URL=http://qdrant-replica:6333
RAG_MEMORY_ENABLED=true
QDRANT_URL=http://qdrant-lb:6333
QDRANT_COLLECTION=assetslake_operation_memories
QDRANT_VECTOR_SIZE=384
QDRANT_REPLICATION_FACTOR=2

# ─── AI Replica Write Scope ───────────────────────────────────
AI_REPLICA_WRITE_ENABLED=true
AI_REPLICA_QDRANT_URL=http://qdrant-replica:6333
AI_REPLICA_ACTION_COLLECTION=assetslake_ai_replica_actions
AI_REPLICA_VECTOR_SIZE=64

# ─── Verification App ────────────────────────────────────────
VERIFICATION_APP_KEY=assetslake
VERIFICATION_OWNER_EMAIL=hanakagumi@outlook.com
VERIFICATION_EMAIL_FROM=hanakagumi@outlook.com
VERIFICATION_SMS_SENDER=AssetsLake
VERIFICATION_CODE_DIGITS=6
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_DEV_CODE_VISIBLE=true
VERIFICATION_EMAIL_PROVIDER=auto
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=
GMAIL_SMTP_PASS=
GMAIL_SMTP_FROM_EMAIL=
GMAIL_SMTP_FROM_NAME=AssetsLake
OUTLOOK_SMTP_HOST=smtp-mail.outlook.com
OUTLOOK_SMTP_PORT=587
OUTLOOK_SMTP_USERNAME=
OUTLOOK_SMTP_USER=
OUTLOOK_SMTP_PASSWORD=
OUTLOOK_SMTP_PASS=
OUTLOOK_SMTP_FROM_EMAIL=
OUTLOOK_SMTP_FROM_NAME=AssetsLake
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASS=
SMTP_FROM_EMAIL=hanakagumi@outlook.com
SMTP_FROM_NAME=AssetsLake
VERIFICATION_SMS_PROVIDER=local
# Twilio real SMS provider. Keep blank in repo; set locally via shell/.env when testing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
REAL_EMAIL_TO=

# ─── HA Maintenance Batch ─────────────────────────────────────
HA_MAINTENANCE_INTERVAL_SECONDS=300
HA_MAINTENANCE_MAX_STALENESS_SECONDS=900
HA_POSTGRES_LAG_WARN_BYTES=104857600
HA_QDRANT_COLLECTIONS=assetslake_operation_memories

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
NEXT_PUBLIC_MINIO_BUCKET=art-assets
KIALI_CONSOLE_URL=/kiali/console/graph/namespaces?namespaces=assetslake&graphType=service&duration=300&refresh=15000
KIALI_PROXY_URL=http://127.0.0.1:20001
KIALI_PORT=20001
SKYWALKING_UI_URL=http://localhost:18088/dashboard/GENERAL/All/General-Root
