{
  "name": "assetslake-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test:ut": "node --test scripts/plugin-groups-regression.test.mjs scripts/atomic-plugin-orchestrator.test.mjs scripts/wiki-design-app-contract.test.mjs scripts/people-intelligence-contract.test.mjs scripts/app-assistant-contract.test.mjs scripts/gantt-model.test.mjs scripts/workflow-automation-model.test.mjs scripts/report-analytics-model.test.mjs scripts/calendar-workload-model.test.mjs scripts/board-planning-model.test.mjs scripts/issue-evidence-model.test.mjs scripts/enterprise-governance-model.test.mjs scripts/emergent-intelligence-model.test.mjs scripts/issue-asset-attach-contract.test.mjs scripts/concurrency-readiness.test.mjs scripts/asset-security-contract.test.mjs scripts/auth-session-contract.test.mjs scripts/rbac-contract.test.mjs scripts/security-audit-contract.test.mjs scripts/admin-control-contract.test.mjs",
    "test:it": "node --test scripts/management-integration.test.mjs",
    "test:contract": "node --test scripts/quality-gates-contract.test.mjs scripts/issue-asset-attach-contract.test.mjs scripts/concurrency-readiness.test.mjs scripts/asset-security-contract.test.mjs scripts/auth-session-contract.test.mjs scripts/rbac-contract.test.mjs scripts/security-audit-contract.test.mjs scripts/admin-control-contract.test.mjs",
    "test:regression": "node --test scripts/plugin-groups-regression.test.mjs",
    "test:smoke": "node --test scripts/data-lake-smoke.test.mjs",
    "test:auth-locks": "node --test scripts/auth-locks-integration.test.mjs",
    "test:three-user-lock": "node --test scripts/three-user-exclusive-lock.test.mjs",
    "test:ten-user-lock": "node --test scripts/ten-user-exclusive-lock.test.mjs",
    "test:concurrency": "node --test scripts/high-concurrency-smoke.test.mjs",
    "test:concurrency-readiness": "node --test scripts/concurrency-readiness.test.mjs",
    "test:asset-security": "node --test scripts/asset-security-contract.test.mjs",
    "test:auth-session": "node --test scripts/auth-session-contract.test.mjs",
    "test:rbac": "node --test scripts/rbac-contract.test.mjs",
    "test:security-audit": "node --test scripts/security-audit-contract.test.mjs",
    "test:admin-control": "node --test scripts/admin-control-contract.test.mjs",
    "test:wiki-design": "node --test scripts/wiki-design-app-contract.test.mjs",
    "test:emergence": "node --test scripts/emergence-snapshot.test.mjs",
    "test:verification": "node --test scripts/verification-integration.test.mjs",
    "test:verification-email": "node --test scripts/verification-email-integration.test.mjs",
    "test:verification-real": "node --test scripts/verification-real-sms.test.mjs",
    "test:verification-email-real": "node --test scripts/verification-real-email.test.mjs",
    "test:gantt-model": "node --test scripts/gantt-model.test.mjs",
    "test:workflow-automation-model": "node --test scripts/workflow-automation-model.test.mjs",
    "test:report-analytics-model": "node --test scripts/report-analytics-model.test.mjs",
    "test:calendar-workload-model": "node --test scripts/calendar-workload-model.test.mjs",
    "test:board-planning-model": "node --test scripts/board-planning-model.test.mjs",
    "test:issue-evidence-model": "node --test scripts/issue-evidence-model.test.mjs",
    "test:enterprise-governance-model": "node --test scripts/enterprise-governance-model.test.mjs",
    "test:emergent-intelligence-model": "node --test scripts/emergent-intelligence-model.test.mjs",
    "test:issue-asset-attach": "node --test scripts/issue-asset-attach-contract.test.mjs",
    "test:browser-paths": "node --test scripts/browser-paths.test.mjs",
    "test:web-auth": "playwright test e2e/auth-console-smoke.spec.ts --project=chromium",
    "test:uat": "playwright test e2e/product-journey.spec.ts e2e/operation-branches.spec.ts --project=chromium",
    "test:quality:local": "pnpm run type-check && pnpm run test:ut && pnpm run test:contract && pnpm run test:it && pnpm run test:uat",
    "test:quality:live": "pnpm run test:quality:local && pnpm run test:smoke && pnpm run test:auth-locks && pnpm run test:concurrency",
    "test:e2e": "pnpm run test:e2e:run && pnpm run test:e2e:artifacts",
    "test:e2e:run": "playwright test",
    "test:e2e:artifacts": "node --test scripts/playwright-artifacts.test.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:trace": "playwright test --trace on",
    "test:e2e:gallery": "playwright test e2e/interface-gallery.spec.ts --trace on",
    "test:e2e:branches": "playwright test e2e/operation-branches.spec.ts --trace on",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:browserbase": "node --test scripts/browserbase-smoke.test.mjs",
    "test:all": "pnpm run test:ut && pnpm run test:it && pnpm run test:regression && pnpm run test:browser-paths",
    "test:full": "pnpm run test:all && pnpm run test:e2e && pnpm run test:smoke && pnpm run type-check && pnpm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.40.0",
    "axios": "^1.7.2",
    "bytes": "^3.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.395.0",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "react-dropzone": "^14.2.3",
    "react-hot-toast": "^2.4.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bytes": "^3.1.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5"
  }
}
